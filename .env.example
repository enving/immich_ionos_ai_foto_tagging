# Immich Environment Configuration
# Copy this file to .env and fill in your values

# The location where your uploaded files are stored
UPLOAD_LOCATION=./library

# The location where your database files are stored
DB_DATA_LOCATION=./postgres

# The Immich version to use (e.g., "v2.5.6" or "release")
IMMICH_VERSION=release

# Bind to IPv4 (required for Docker port-forwarding on macOS)
IMMICH_HOST=0.0.0.0

# Database credentials - CHANGE THESE
DB_PASSWORD=your_secure_random_password
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# =============================================================================
# IONOS AI Integration (optional)
# Get your API key from https://ionos.com/ai
# =============================================================================
IONOS_API_KEY=your_ionos_api_key
IONOS_API_URL=https://openai.inference.de-txl.ionos.com/v1
IONOS_MODEL=mistralai/Mistral-Small-24B-Instruct

# Immich user credentials (for trigger_immich_scan.py)
IMMICH_USER_EMAIL=your_email@domain.com
IMMICH_USER_PASSWORD=your_immich_password

# Indexing configuration
IMAGE_DIR=/path/to/your/photos
BATCH_SIZE=10
RATE_LIMIT_DELAY=1.0
MAX_RETRIES=3